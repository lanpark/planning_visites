<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="MailApp">
  <Id>c18d7d4f-f69a-4536-bcb7-03e767f3cfc5</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Nicolas</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="Planning Visites"/>
  <Description DefaultValue="Ouvre l'application Power Apps de planning des visites."/>
  <IconUrl DefaultValue="https://lanpark.github.io/planning_visites/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://lanpark.github.io/planning_visites/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://lanpark.github.io/planning_visites/"/>
  <AppDomains>
    <AppDomain>lanpark.github.io</AppDomain>
    <AppDomain>apps.powerapps.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>
  <!-- FormSettings est requis pour la validation du schéma, mais ignoré dès
       qu'un bloc VersionOverrides est présent (voir ci-dessous). Il n'est
       donc plus utilisé pour charger l'add-in : c'est VersionOverrides qui
       déclare le vrai comportement (bouton de ruban). -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://lanpark.github.io/planning_visites/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://lanpark.github.io/planning_visites/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
                     xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
                     xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="planningGroupRead">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="btnOpenPlanningRead">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Title"/>
                    <Description resid="Button.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <!-- Removed invalid TaskpaneId element -->
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="planningGroupCompose">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="btnOpenPlanningCompose">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Title"/>
                    <Description resid="Button.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <!-- Removed invalid TaskpaneId element -->
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://lanpark.github.io/planning_visites/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://lanpark.github.io/planning_visites/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://lanpark.github.io/planning_visites/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://lanpark.github.io/planning_visites/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Planning Visites"/>
        <bt:String id="Button.Label" DefaultValue="Planning Visites"/>
        <bt:String id="Button.Title" DefaultValue="Ouvrir le planning des visites"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Description" DefaultValue="Lance l'application de planification et de remplissage automatique des visites."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>

</OfficeApp>